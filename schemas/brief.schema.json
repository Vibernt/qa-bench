{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-bench.dev/schemas/brief.schema.json",
  "title": "brief.json: everything an adapter is told about an episode (never the answer key)",
  "type": "object",
  "additionalProperties": false,
  "required": ["episode_id", "bench_version", "track", "targets", "roles", "budget"],
  "properties": {
    "episode_id": { "type": "string", "description": "Opaque; reveals nothing about what is switched on" },
    "bench_version": { "type": "string" },
    "track": { "type": "string" },
    "targets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "url"],
        "properties": { "name": { "type": "string" }, "url": { "type": "string", "format": "uri" } }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["role", "accounts"],
        "properties": {
          "role": { "type": "string" },
          "accounts": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["username", "password"],
              "properties": { "username": { "type": "string" }, "password": { "type": "string" } }
            }
          }
        }
      }
    },
    "inbox": {
      "type": "object", "additionalProperties": false, "required": ["address", "api"],
      "properties": { "address": { "type": "string" }, "api": { "type": "string", "format": "uri" } }
    },
    "budget": {
      "type": "object", "additionalProperties": false, "required": ["wall_time_s"],
      "properties": { "wall_time_s": { "type": "integer", "minimum": 1 }, "money_usd": { "type": "number", "minimum": 0 } }
    },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "title", "role", "steps"],
        "properties": {
          "id": { "type": "string" }, "title": { "type": "string" }, "role": { "type": "string" },
          "start": { "type": "string" }, "steps": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "goal": { "type": "string" },
    "pages": { "type": "array", "items": { "type": "string" } },
    "rules": { "$ref": "#/$defs/rules" },
    "categories": { "type": "array", "items": { "$ref": "defs.schema.json#/$defs/category" }, "description": "Categories in scope for this track" },
    "out": {
      "type": "object", "additionalProperties": false, "required": ["findings", "evidence_dir"],
      "description": "Where the adapter writes, as paths inside the adapter's view",
      "properties": { "findings": { "type": "string" }, "evidence_dir": { "type": "string" } }
    }
  },
  "$defs": {
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "description": "Behaviour rules the adapter must honour (live sites)",
      "properties": {
        "methods": { "type": "array", "items": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"] } },
        "forms": { "type": "boolean", "description": "May the adapter submit forms" },
        "robots_txt": { "enum": ["honour", "ignore"] },
        "min_interval_ms": { "type": "integer", "minimum": 0, "description": "Minimum time between page loads" },
        "max_pages": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
