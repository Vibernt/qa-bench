{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-bench.dev/schemas/defs.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "labelId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9.-]*$",
      "description": "<app-prefix>.<name>, e.g. expense.wrong-total"
    },
    "category": {
      "enum": [
        "functional",
        "consistency",
        "permission",
        "error-handling",
        "visual",
        "copy",
        "a11y",
        "perf",
        "usability",
        "email",
        "security-hygiene",
        "l10n"
      ]
    },
    "class": {
      "enum": [
        "deterministic",
        "judged",
        "human"
      ]
    },
    "severity": {
      "enum": [
        "critical",
        "major",
        "minor"
      ],
      "description": "By impact on a real user, not by category (scorer/README.md, Severity). critical: blocks a core journey for some users, loses or corrupts data, leaks access or money, or is an accessibility blocker. major: wrong result or clearly broken UI on a core journey with a workaround, layout that breaks or hides content, misleading numbers. minor: cosmetic, copy typos, edge cases off the main path, small accessibility issues with no blocker. Weights for weighted recall: 5 / 3 / 1"
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "minimum": 0
        },
        "h": {
          "type": "number",
          "minimum": 0
        },
        "viewport": {
          "type": "string",
          "description": "e.g. 1280x720"
        }
      }
    },
    "where": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route"
      ],
      "properties": {
        "route": {
          "type": "string",
          "description": "Path (no host), e.g. /inventory.html. '*' means anywhere in the app"
        },
        "role": {
          "type": "string"
        },
        "step": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "region": {
          "$ref": "#/$defs/region"
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_usd": {
          "type": "number",
          "minimum": 0
        },
        "compute_usd": {
          "type": "number",
          "minimum": 0
        },
        "human_hours": {
          "type": "number",
          "minimum": 0
        },
        "human_rate_usd_per_hour": {
          "type": "number",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "description": "How the system worked, where its driver can tell: counted by the orchestrator from the transcript, or reported by the adapter. Not scored; reported beside the scores (e.g. whether a system looked at the rendered page).",
      "properties": {
        "tool_calls": {
          "type": "integer",
          "minimum": 0,
          "description": "Tool or browser actions the system took"
        },
        "screenshots_taken": {
          "type": "integer",
          "minimum": 0,
          "description": "Tool calls that captured a screenshot"
        },
        "screenshots_viewed": {
          "type": "integer",
          "minimum": 0,
          "description": "Times the system looked at an image (e.g. a model reading a screenshot), not just saved one"
        }
      }
    }
  }
}
